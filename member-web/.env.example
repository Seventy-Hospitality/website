# API origin. Leave empty for same-origin (production) and for dev, where the
# Vite server proxies /api to http://127.0.0.1:3001 (see vite.config.ts).
VITE_API_URL=

# Google Identity Services web client ID (OAuth "Web application" client).
# When empty the "Continue with Google" button renders in a disabled,
# "not configured" state and the rest of the app works normally.
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple services ID (the web audience, not the native bundle ID).
# Same graceful degradation as Google when empty.
VITE_APPLE_CLIENT_ID=

# Stripe publishable key. Checkout flows (W1/W3) mount Stripe Elements through
# src/lib/stripe.tsx; when empty those flows show a "payments not configured"
# state instead of crashing.
VITE_STRIPE_PUBLISHABLE_KEY=
