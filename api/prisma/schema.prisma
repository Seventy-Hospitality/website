generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ──

model User {
  id              String    @id @default(cuid())
  email           String    @unique // normalized: lowercased + trimmed
  emailVerifiedAt DateTime?
  name            String
  staffRole       String? // null | "staff" | "admin"
  status          String    @default("active") // "active" | "suspended" | "deleted"
  deletedAt       DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[] // legacy admin sessions; dropped after cutover
  credentials  UserCredential[]
  identities   AuthIdentity[]
  authSessions AuthSession[]
  member       Member?
  notes        AdminNote[]      @relation("noteAuthor")

  @@map("users")
}

// Secrets live in their own table so raw-row serialization of users can
// never leak a hash.
model UserCredential {
  id         String   @id @default(cuid())
  userId     String
  type       String // "password" (later "passkey")
  secretHash String // argon2id PHC string
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("user_credentials")
}

model AuthIdentity {
  id              String    @id @default(cuid())
  userId          String
  provider        String // "google" | "apple"
  subject         String // provider "sub" — the stable key
  email           String? // as asserted; informational only
  emailVerified   Boolean   @default(false)
  isPrivateRelay  Boolean   @default(false)
  refreshTokenEnc String? // Apple only: needed for /auth/revoke on delete
  linkedAt        DateTime  @default(now())
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject]) // NOT unique on email
  @@index([userId])
  @@map("auth_identities")
}

// One row per device. Refresh tokens are stored hashed and rotated on every
// use; previousTokenHash keeps a short grace window for network retries.
model AuthSession {
  id                String    @id @default(cuid())
  userId            String
  client            String // "admin_web" | "member_mobile"
  refreshTokenHash  String    @unique // sha256
  previousTokenHash String? // rotation grace window
  rotatedAt         DateTime?
  issuedAt          DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokedReason     String?
  deviceName        String?
  ip                String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

// All one-time tokens (replaces magic_link_tokens after cutover).
model AuthToken {
  id          String    @id @default(cuid())
  purpose     String // magic_link | email_verification | password_reset | oauth_nonce | email_change
  identifier  String // email or userId
  tokenHash   String    @unique
  bindingHash String? // sha256(device verifier) — PKCE-style device binding
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([purpose, identifier])
  @@map("auth_tokens")
}

model Session {
  id           String   @id
  userId       String
  expiresAt    DateTime
  lastActiveAt DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("magic_link_tokens")
}

// ── Members ──

model Member {
  id        String   @id @default(cuid())
  userId    String?  @unique
  email     String   @unique
  firstName String
  lastName  String
  phone     String?

  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?        @relation(fields: [userId], references: [id])
  membership Membership?
  notes      AdminNote[]
  bookings   Booking[]

  @@map("members")
}

model MembershipPlan {
  id              String  @id @default(cuid())
  name            String
  stripePriceId   String  @unique
  stripeProductId String
  amountCents     Int
  interval        String // "month" | "year"
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@map("membership_plans")
}

model Membership {
  id                   String   @id @default(cuid())
  memberId             String   @unique
  planId               String
  stripeSubscriptionId String   @unique
  status               String // "active" | "past_due" | "canceled" | "unpaid" | "incomplete"
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  @@map("memberships")
}

model AdminNote {
  id       String @id @default(cuid())
  memberId String
  authorId String
  content  String

  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author User   @relation("noteAuthor", fields: [authorId], references: [id])

  @@index([memberId])
  @@map("admin_notes")
}

// ── Events ──

model Event {
  id         String   @id @default(cuid())
  seq        Int      @default(autoincrement())
  streamType String
  streamId   String
  eventType  String
  data       Json
  occurredAt DateTime
  recordedAt DateTime @default(now())
  source     String   @default("app")
  actorId    String?

  @@unique([seq])
  @@index([streamType, streamId, seq])
  @@index([streamType, seq])
  @@map("events")
}

model StreamCheckpoint {
  id           String @id @default(cuid())
  streamType   String
  eventSeqHigh Int
  state        Json

  @@unique([streamType])
  @@map("stream_checkpoints")
}

// ── Bookings ──

model Court {
  id                          String   @id @default(cuid())
  name                        String
  slotDurationMinutes         Int      @default(60)
  operatingHoursStart         String   @default("07:00")
  operatingHoursEnd           String   @default("22:00")
  maxAdvanceDays              Int      @default(7)
  maxBookingsPerMemberPerDay  Int      @default(2)
  cancellationDeadlineMinutes Int      @default(60)
  active                      Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  eventClaims                 ClubEventCourt[]

  @@map("courts")
}

model Shower {
  id                          String   @id @default(cuid())
  name                        String
  slotDurationMinutes         Int      @default(30)
  operatingHoursStart         String   @default("07:00")
  operatingHoursEnd           String   @default("22:00")
  maxAdvanceDays              Int      @default(3)
  maxBookingsPerMemberPerDay  Int      @default(1)
  cancellationDeadlineMinutes Int      @default(30)
  active                      Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("showers")
}

model Booking {
  id           String   @id @default(cuid())
  facilityType String
  facilityId   String
  memberId     String
  date         DateTime @db.Date
  startTime    String
  endTime      String
  status       String   @default("confirmed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@index([facilityType, facilityId, date, status])
  @@index([memberId, date])
  @@map("bookings")
}

model ClubEvent {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?
  details   String?
  startsAt  DateTime
  endsAt    DateTime
  timezone  String   @default("America/New_York")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courts    ClubEventCourt[]

  @@index([active, startsAt])
  @@index([startsAt])
  @@map("club_events")
}

model ManagedMediaAsset {
  id               String    @id @default(cuid())
  publicPath       String    @unique
  usage            String
  status           String    @default("pending")
  contentType      String
  sizeBytes        Int
  originalFilename String
  ownerType        String?
  ownerId          String?
  attachedAt       DateTime?
  discardedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([usage, status, createdAt])
  @@index([ownerType, ownerId])
  @@map("managed_media_assets")
}

model ClubEventCourt {
  id        String   @id @default(cuid())
  eventId   String
  courtId   String
  createdAt DateTime @default(now())

  event ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  court Court     @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@unique([eventId, courtId])
  @@index([courtId])
  @@map("club_event_courts")
}
