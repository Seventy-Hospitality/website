# Database
DATABASE_URL="postgresql://user:password@localhost:5432/seventy?schema=public"

# Auth
JWT_SECRET="generate-a-64-char-random-string-here"

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# The API version the MOBILE Stripe SDK pins (PaymentSheet ephemeral keys
# must be minted with it). Update in lockstep with the app's Stripe SDK.
# Defaults to the server pin when unset.
STRIPE_MOBILE_API_VERSION=

# Vercel Cron
CRON_SECRET="generate-a-random-string-here"

# Resend
RESEND_API_KEY=re_...

# Push notifications (Expo). Without the token the push adapter logs
# instead of sending (decision + delivery-ledger logic still run).
EXPO_PUSH_ACCESS_TOKEN=

# Where operational staff alerts go (disputes, failed refunds, blocked
# account deletions). Unset = staff alerts are logged and dropped.
STAFF_ALERT_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web App: the public web origin. Member-facing email links (/verify-email,
# /reset-password, member magic-link landing) resolve against it, and the
# admin app lives under /admin on the same origin. In dev, point it at
# whichever Vite server you are exercising (admin dev serves under
# http://localhost:5173/admin/).
WEB_URL=http://localhost:5173

# The venue's IANA timezone: the single wall clock all reservation slots and
# operating hours live on.
VENUE_TIMEZONE=America/New_York

# Native-app magic-link redirect allowlist. Comma-separated; custom schemes end
# with ':' (matched by scheme), http(s) entries are matched by scheme + exact
# hostname (any port). Defaults cover the Expo/dev targets when unset.
MOBILE_AUTH_REDIRECT_TARGETS=seventy:,exp:,http://localhost,https://auth.expo.io

# Media
MEDIA_BACKEND=local
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_PREFIX=
MEDIA_STALE_UPLOAD_MAX_AGE_HOURS=24
MEDIA_STALE_UPLOAD_CLEANUP_LIMIT=10

# OAuth (Club70 member sign-in, native app and member web). The API boots
# without these; the /api/auth/oauth endpoints return NOT_CONFIGURED until
# they are set. Web callers mark themselves with the `X-Client-Type: web`
# header and get httpOnly session cookies instead of body tokens.
# Comma-separated allowlist of Google client IDs (iOS, Android, and the web
# client ID used by the member web app's Google Identity Services sign-in).
GOOGLE_OAUTH_CLIENT_IDS=
# Apple Sign in: the native bundle ID and/or the web services ID (Sign in
# with Apple JS on the member web app) are the accepted token audiences;
# either alone works. Team ID, key ID and the .p8 private key (newlines
# escaped as \n) enable the authorization-code exchange that stores the
# refresh token for /auth/revoke.
APPLE_BUNDLE_ID=
APPLE_WEB_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Account surface (package E)
# Encrypts private media (government-ID photos) at rest. REQUIRED in
# production; deliberately its own key so a JWT_SECRET rotation can never
# brick stored photos. Local dev derives from JWT_SECRET when unset.
MEDIA_ENCRYPTION_KEY=
# Filesystem root for private media on the local backend. Defaults to
# ./uploads-private (never under ./uploads, which is publicly served).
MEDIA_PRIVATE_ROOT=
# Signs the member QR credential (60s HMAC tokens). Defaults to a dedicated
# derivation of JWT_SECRET when unset.
MEMBER_QR_SECRET=
