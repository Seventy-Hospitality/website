# Club70 mobile — public (EXPO_PUBLIC_*) build-time config.
# Every value is optional: with an empty env the app runs, OAuth buttons render
# a "not configured" state (no SDK loaded), and Stripe flows show a config notice.
# Copy to `.env` and fill in the values you have.

# API origin the app talks to.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Stripe publishable key (pk_test_... / pk_live_...) — enables PaymentSheet.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple merchant id for Apple Pay in PaymentSheet (optional).
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.club.seventy.mobile

# Google OAuth client IDs (native ID-token flow). Any absent -> Google degraded.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Sign in with Apple services id (web audience / Android). iOS uses the native
# flow and needs no client id here.
EXPO_PUBLIC_APPLE_CLIENT_ID=
